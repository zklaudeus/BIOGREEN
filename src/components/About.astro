---
// src/components/About.astro
import { Image } from 'astro:assets';
import aboutImg from '../assets/images/vertical-1.jpg';
---

<section id="nosotros" class="py-16 md:py-24 bg-gris-claro">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <!-- Contenedor Visual -->
      <div
        class="order-2 md:order-1 relative rounded-3xl overflow-hidden shadow-2xl h-[400px] bg-gris-claro flex items-center justify-center border border-verde-oscuro/20"
      >
        <!-- Fondo suave -->
        <div class="absolute inset-0 bg-verde opacity-5"></div>

        <!-- Imagen -->
        <Image
          src={aboutImg}
          alt="Trabajadores en planta de compostaje BioGreen"
          class="w-full h-full object-cover transition-opacity duration-500"
        />
      </div>

      <!-- Texto -->
      <div class="order-1 md:order-2">
        <h1
          class="text-4xl lg:text-5xl titulo-secundario text-verde-oscuro mb-6 tracking-tight flex items-center gap-2"
        >
          ¿Qué es BIOGREEN?
        </h1>
        <div class="w-24 h-1.5 bg-verde mb-8 rounded-full"></div>
        <p class="text-lg text-verde-oscuro mb-6 leading-relaxed font-sans">
          BIOGREEN es una planta de compostaje <strong>
            ubicada en Santa Rosa de Quinel, Cabrero</strong
          >, especializada en la valorización de residuos orgánicos no
          peligrosos.
        </p>
        <p class="text-lg text-verde-oscuro leading-relaxed font-sans">
          Transformamos residuos como lodos orgánicos, restos agroindustriales,
          desechos forestales y residuos alimentarios en compost de alta
          calidad, contribuyendo a la economía circular regional.
        </p>
      </div>
    </div>
  </div>
</section>
