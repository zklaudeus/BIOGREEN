---
// src/components/AutorizacionSanitaria.astro
---

<section id="autorizacion" class="py-24 bg-verde-oscuro text-gris-claro text-gris-claro relative overflow-hidden">
  <!-- Decorativos de fondo -->
  <div class="absolute inset-0 bg-gradient-to-br from-verde-oscuro to-verde opacity-80 pointer-events-none"></div>
  <div class="absolute top-0 left-0 -translate-x-1/3 -translate-y-1/3 w-[500px] h-[500px] bg-verde-oscuro text-gris-claro rounded-full blur-3xl opacity-20 pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 translate-x-1/4 translate-y-1/4 w-[500px] h-[500px] bg-green-800 rounded-full blur-3xl opacity-20 pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-14">
      <!-- Ícono de escudo/autorización -->
      <div class="w-20 h-20 bg-gris-claro/10 backdrop-blur-sm rounded-3xl flex items-center justify-center mx-auto mb-8 ring-2 ring-white/20 shadow-2xl">
        <svg class="w-10 h-10 text-verde" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
      </div>
      <h3 class="text-4xl md:text-5xl font-black tracking-tight mb-4">Autorización Sanitaria</h3>
      <div class="w-24 h-1.5 bg-verde mx-auto rounded-full"></div>
    </div>

    <!-- Panel principal de autorización -->
    <div class="bg-gris-claro/5 backdrop-blur-sm border border-white/10 rounded-[2rem] p-10 md:p-14 shadow-2xl">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

        <!-- Resolución -->
        <div class="group flex flex-col items-center text-center p-6 rounded-2xl hover:bg-gris-claro/10 transition-colors duration-300">
          <div class="w-14 h-14 bg-verde/20 text-verde rounded-xl flex items-center justify-center mb-5 group-hover:bg-verde group-hover:text-gris-claro transition-colors duration-300">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <p class="text-verde text-xs font-bold uppercase tracking-widest mb-2">Resolución</p>
          <p class="text-gris-claro text-lg font-bold leading-tight">N° 2508140655</p>
          <p class="text-gris-claro/70 text-sm mt-1 font-light">SEREMI de Salud Biobío</p>
        </div>

        <!-- Fecha -->
        <div class="group flex flex-col items-center text-center p-6 rounded-2xl hover:bg-gris-claro/10 transition-colors duration-300 border-y md:border-y-0 md:border-x border-white/10">
          <div class="w-14 h-14 bg-verde/20 text-verde rounded-xl flex items-center justify-center mb-5 group-hover:bg-verde group-hover:text-gris-claro transition-colors duration-300">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <p class="text-verde text-xs font-bold uppercase tracking-widest mb-2">Fecha de Emisión</p>
          <p class="text-gris-claro text-lg font-bold leading-tight">13 de junio</p>
          <p class="text-gris-claro/70 text-sm mt-1 font-light">de 2025</p>
        </div>

        <!-- Capacidad -->
        <div class="group flex flex-col items-center text-center p-6 rounded-2xl hover:bg-gris-claro/10 transition-colors duration-300">
          <div class="w-14 h-14 bg-verde/20 text-verde rounded-xl flex items-center justify-center mb-5 group-hover:bg-verde group-hover:text-gris-claro transition-colors duration-300">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <p class="text-verde text-xs font-bold uppercase tracking-widest mb-2">Capacidad Operativa</p>
          <p class="text-gris-claro text-lg font-bold leading-tight">30 Ton / día</p>
          <p class="text-gris-claro/70 text-sm mt-1 font-light">Residuos orgánicos no peligrosos</p>
        </div>

      </div>

      <!-- Logo SEREMI + Descripción -->
      <div class="mt-10 pt-8 border-t border-white/10 flex flex-col md:flex-row items-center gap-8 text-center md:text-left max-w-3xl mx-auto">
        <!-- Logo SEREMI -->
        <div class="flex-shrink-0 bg-gris-claro rounded-2xl p-4 shadow-lg flex items-center justify-center w-36 h-24">
          <img
            src="/src/assets/logo-xl.png"
            alt="Logo SEREMI de Salud Biobío"
            class="max-h-full max-w-full object-contain"
          />
        </div>
        <!-- Texto -->
        <p class="text-gris-claro/80 font-light text-lg leading-relaxed">
          Autorizados legalmente para recibir y valorizar residuos orgánicos no peligrosos, garantizando cumplimiento normativo, trazabilidad completa y altos estándares sanitarios y ambientales.
        </p>
      </div>

    </div>
  </div>
</section>
