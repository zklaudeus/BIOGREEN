---
// src/components/ComoLoHacemos.astro
const pasos = [
  {
    numero: "01",
    titulo: "Residuos Orgánicos",
    descripcion: "Recolectamos residuos orgánicos industriales, agroindustriales y forestales en origen.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/><path d="M8 6V4m4 2V4m4 2V4"/></svg>`,
    color: "from-verde-oscuro to-green-500",
    bg: "bg-gris-claro",
    border: "border-verde-oscuro/20",
    angle: -90,
  },
  {
    numero: "02",
    titulo: "Traslado a la Planta",
    descripcion: "Transportamos de forma segura y trazable hacia nuestra planta de compostaje autorizada.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 3h15v13H1zM16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>`,
    color: "from-verde-oscuro to-verde",
    bg: "bg-gris-claro",
    border: "border-verde-oscuro/20",
    angle: -18,
  },
  {
    numero: "03",
    titulo: "Proceso de Compostaje",
    descripcion: "Aplicamos compostaje industrial controlado con altos estándares sanitarios y ambientales.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/><path d="M12 6v6l4 2"/></svg>`,
    color: "from-verde to-verde-oscuro",
    bg: "bg-gris-claro",
    border: "border-verde-oscuro/20",
    angle: 54,
  },
  {
    numero: "04",
    titulo: "Abono Orgánico",
    descripcion: "Obtenemos compost de alta calidad, rico en nutrientes y materia orgánica estabilizada.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12M12 12C12 7 7 4 2 4c0 5 3 9 10 8M12 12c0-5 5-8 10-8-1 5-4 9-10 8"/></svg>`,
    color: "from-verde/60 to-verde-oscuro",
    bg: "bg-gris-claro",
    border: "border-verde-oscuro/20",
    angle: 126,
  },
  {
    numero: "05",
    titulo: "Fertilización para la Tierra",
    descripcion: "El compost se devuelve al suelo, cerrando el ciclo y regenerando los ecosistemas.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M4.93 4.93l14.14 14.14M12 2v4M12 18v4M2 12h4M18 12h4"/></svg>`,
    color: "from-verde-oscuro/60 to-verde-oscuro",
    bg: "bg-gris-claro",
    border: "border-verde-oscuro/20",
    angle: 198,
  },
];

// Calcular posiciones en el círculo (pentagono)
// 5 nodos igualmente espaciados, empezando desde arriba (-90°)
const R = 38; // radio en porcentaje del contenedor
const centerX = 50;
const centerY = 50;
const positions = pasos.map((_, i) => {
  const angleDeg = -90 + (i * 360) / 5;
  const angleRad = (angleDeg * Math.PI) / 180;
  return {
    x: centerX + R * Math.cos(angleRad),
    y: centerY + R * Math.sin(angleRad),
  };
});
---

<section id="como-lo-hacemos" class="py-24 bg-gris-claro relative overflow-hidden">
  <!-- Fondo decorativo -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-10 left-10 w-72 h-72 bg-gris-claro rounded-full filter blur-3xl opacity-40"></div>
    <div class="absolute bottom-10 right-10 w-96 h-96 bg-verde/10 rounded-full filter blur-3xl opacity-40"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Encabezado -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class=" text-sm titulo-secundario text-verde mb-3">Nuestro Proceso</h2>
      <h3 class="text-4xl md:text-5xl font-title text-verde-oscuro mb-6 tracking-tight">¿Cómo lo hacemos?</h3>
      <div class="w-24 h-1.5 bg-verde mx-auto rounded-full"></div>
      <p class="mt-6 text-lg text-verde-oscuro/60 font-sans leading-relaxed">
        Un ciclo continuo que transforma residuos en recursos, devolviendo valor a la tierra.
      </p>
    </div>

    <!-- Layout: imagen arriba en mobile, lado a lado en desktop -->
    <div class="flex flex-col xl:flex-row items-center gap-10 xl:gap-16">

      <!-- CICLO VISUAL -->
      <div class="w-full xl:w-full flex items-center justify-center">
        <img
          src="/images/ciclo.png"
          alt="Ciclo de compostaje BIOGREEN"
          class="w-full max-w-xs sm:max-w-sm md:max-w-md xl:max-w-full object-contain drop-shadow-xl mx-auto"
        />
      </div>

      <!-- LISTA DE PASOS -->
      <div class="w-full xl:w-1/2">
        <ol class="space-y-4">
          {pasos.map((paso, i) => (
            <li class={`group flex items-start gap-4 p-4 sm:p-5 rounded-2xl border ${paso.border} ${paso.bg} hover:shadow-lg transition-all duration-300`}>
              <!-- Número -->
              <div class={`flex-shrink-0 w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-gradient-to-br ${paso.color} flex items-center justify-center shadow-md group-hover:scale-110 transition-transform duration-300`}>
                <span class="text-gris-claro text-xs sm:text-sm font-title">{paso.numero}</span>
              </div>
              <!-- Contenido -->
              <div>
                <h4 class="text-sm sm:text-base font-title text-verde-oscuro mb-0.5">{paso.titulo}</h4>
                <p class="text-xs sm:text-sm text-verde-oscuro/60 leading-relaxed font-sans">{paso.descripcion}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

    </div>
  </div>
</section>

<style>
  .cycle-spin {
    animation: spin-slow 12s linear infinite;
  }

  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .cycle-node {
    animation: pulse-node 3s ease-in-out infinite;
  }

  .cycle-node:nth-child(2) { animation-delay: 0.6s; }
  .cycle-node:nth-child(3) { animation-delay: 1.2s; }
  .cycle-node:nth-child(4) { animation-delay: 1.8s; }
  .cycle-node:nth-child(5) { animation-delay: 2.4s; }

  @keyframes pulse-node {
    0%, 100% { filter: drop-shadow(0 0 0px rgba(16,185,129,0)); }
    50% { filter: drop-shadow(0 0 8px rgba(11,181,128,0.5)); }
  }
</style>
