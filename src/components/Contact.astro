---
// src/components/Contact.astro
---

<section id="contacto" class="py-24 bg-gris-claro relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <!-- Contact Info -->
      <div class="flex flex-col justify-center">
        <h1
          class="text-4xl md:text-5xl font-title text-verde-oscuro mb-6 tracking-tight font-semibold"
        >
          Ponte en Contacto
        </h1>
        <p class="text-lg text-verde-oscuro mb-10 leading-relaxed font-sans">
          ¿Tienes dudas o necesitas nuestros servicios de disposición?
          Escríbenos y te entregaremos una solución sustentable a tu medida.
        </p>

        <div class="space-y-8">
          <!-- Item 1 -->
          <div class="flex items-start group">
            <div
              class="flex-shrink-0 w-14 h-14 bg-gris-claro text-verde rounded-full flex items-center justify-center border border-verde-oscuro/20 group-hover:bg-verde group-hover:text-gris-claro transition-colors duration-300"
            >
              <svg
                class="w-7 h-7"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
              >
            </div>
            <div class="ml-5">
              <h3 class="text-base titulo-secundario text-verde-oscuro">
                Nuestra Planta
              </h3>
              <p class="text-verde-oscuro mt-2 text-base font-sans">
                Cabrero, Región del Bío Bío, Chile 📍
              </p>
            </div>
          </div>

          <!-- Item 2 -->
          <div class="flex items-start group">
            <div
              class="flex-shrink-0 w-14 h-14 bg-gris-claro text-verde rounded-full flex items-center justify-center border border-verde-oscuro/20 group-hover:bg-verde group-hover:text-gris-claro transition-colors duration-300"
            >
              <svg
                class="w-7 h-7"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path></svg
              >
            </div>
            <div class="ml-5">
              <h3 class="text-base titulo-secundario text-verde-oscuro">
                Correos Electrónicos
              </h3>
              <div class="mt-2 space-y-1">
                <a
                  href="mailto:joaquin.vargas@biogreenrecicla.cl"
                  class="block font-sans text-verde-oscuro text-lg hover:text-verde transition-colors"
                  >joaquin.vargas@biogreenrecicla.cl</a
                >
                <a
                  href="mailto:contacto@biogreenrecicla.cl"
                  class="block font-sans text-verde-oscuro text-lg hover:text-verde transition-colors"
                  >contacto@biogreenrecicla.cl</a
                >
              </div>
            </div>
          </div>

          <!-- Item 3 -->
          <div class="flex items-start group">
            <div
              class="flex-shrink-0 w-14 h-14 bg-gris-claro text-verde rounded-full flex items-center justify-center border border-verde-oscuro/20 group-hover:bg-verde group-hover:text-gris-claro transition-colors duration-300"
            >
              <svg
                class="w-7 h-7"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path></svg
              >
            </div>
            <div class="ml-5">
              <h3 class="text-base titulo-secundario text-verde-oscuro">
                Teléfono
              </h3>
              <a
                href="tel:+56975132551"
                class="text-verde-oscuro font-sans mt-2 block text-lg hover:text-verde transition-colors"
                >+56 9 7513 2551</a
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div
        class="bg-gris-claro p-8 md:p-10 rounded-3xl shadow-lg border border-verde-oscuro/20 h-fit"
        id="form-container"
      >
        <h3
          class="text-2xl titulo-secundario text-verde-oscuro mb-6 font-semibold"
        >
          Envíanos un mensaje
        </h3>

        <!-- Formulario configurado para Web3Forms (gratuito y sin backend) -->
        <form
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="space-y-6"
        >
          <!-- TODO: Reemplaza con tu Access Key de web3forms.com -->
          <input
            type="hidden"
            name="access_key"
            value="d91dd61a-6ee4-4c01-a8d4-dd31c4c48958"
          />
          <input
            type="hidden"
            name="subject"
            value="Nuevo mensaje desde la web de BIOGREEN"
          />
          <input type="hidden" name="from_name" value="Web BIOGREEN" />

          <!-- Honeypot para evitar Spam -->
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display: none;"
          />

          <div>
            <label
              for="name"
              class="block text-sm titulo-secundario text-verde-oscuro mb-1 font-semibold"
              >Tu nombre</label
            >
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full rounded-xl border-verde-oscuro/20 shadow-sm focus:border-verde-oscuro/20 focus:border-verde-oscuro/20 bg-gris-claro py-3.5 px-4 border outline-none transition-all"
              placeholder="Ej. Juan Pérez"
            />
          </div>
          <div>
            <label
              for="email"
              class="block text-sm titulo-secundario text-verde-oscuro mb-1 font-semibold"
              >Correo electrónico</label
            >
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full rounded-xl border-verde-oscuro/20 shadow-sm focus:border-verde-oscuro/20 focus:border-verde-oscuro/20 bg-gris-claro py-3.5 px-4 border outline-none transition-all"
              placeholder="juan@ejemplo.com"
            />
          </div>
          <div>
            <label
              for="message"
              class="block text-sm titulo-secundario text-verde-oscuro mb-1 font-semibold"
              >¿Qué necesitas saber?</label
            >
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              class="w-full rounded-xl border-verde-oscuro/20 shadow-sm focus:border-verde-oscuro/20 focus:border-verde-oscuro/20 bg-gris-claro py-3.5 px-4 border outline-none transition-all resize-none"
              placeholder="Escribe tu mensaje aquí..."></textarea>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full flex justify-center items-center py-4 px-4 border border-transparent rounded-xl shadow-md text-lg titulo-secundario text-gris-claro bg-verde hover:bg-verde-oscuro text-gris-claro hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:border-verde-oscuro/20 transition-all duration-300 transform hover:-translate-y-0.5"
          >
            <span>Enviar Mensaje</span>
            <svg
              id="submit-spinner"
              class="animate-spin ml-3 h-5 w-5 text-gris-claro hidden"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"></circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
              ></path>
            </svg>
          </button>

          <!-- Mensajes de estado -->
          <div
            id="form-result"
            class="hidden mt-4 p-4 rounded-xl text-center font-sans"
          >
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form");
  const result = document.getElementById("form-result");
  const submitBtn = document.getElementById("submit-btn");
  const spinner = document.getElementById("submit-spinner");
  const btnText = submitBtn ? submitBtn.querySelector("span") : null;

  if (form) {
    form.addEventListener("submit", function (e) {
      e.preventDefault();

      // Cambiar estado del botón
      if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
      if (btnText) btnText.textContent = "Enviando...";
      if (spinner) spinner.classList.remove("hidden");

      // Limpiar mensaje anterior
      if (result) {
        result.classList.add("hidden");
        result.className = "hidden mt-4 p-4 rounded-xl text-center font-medium";
      }

      const formData = new FormData(form as HTMLFormElement);
      const object = Object.fromEntries(formData);
      const json = JSON.stringify(object);

      fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: json,
      })
        .then(async (response) => {
          let jsonResponse = await response.json();
          if (response.status == 200) {
            if (result) {
              result.innerHTML =
                "¡Mensaje enviado con éxito! Te contactaremos pronto.";
              result.classList.remove("hidden");
              result.classList.add("bg-gris-claro", "text-verde-oscuro");
            }
            (form as HTMLFormElement).reset();
          } else {
            console.log(response);
            if (result) {
              result.innerHTML =
                jsonResponse.message || "Hubo un error al enviar tu mensaje.";
              result.classList.remove("hidden");
              result.classList.add("bg-red-100", "text-red-800");
            }
          }
        })
        .catch((error) => {
          console.log(error);
          if (result) {
            result.innerHTML =
              "Ocurrió un error inesperado al enviar el mensaje.";
            result.classList.remove("hidden");
            result.classList.add("bg-red-100", "text-red-800");
          }
        })
        .finally(() => {
          if (submitBtn instanceof HTMLButtonElement)
            submitBtn.disabled = false;
          if (btnText) btnText.textContent = "Enviar Mensaje";
          if (spinner) spinner.classList.add("hidden");

          // Ocultar el mensaje de éxito después de 5 segundos
          setTimeout(() => {
            if (result && result.classList.contains("bg-gris-claro")) {
              result.classList.add("hidden");
            }
          }, 5000);
        });
    });
  }
</script>
