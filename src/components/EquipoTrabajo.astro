---
// src/components/EquipoTrabajo.astro
const equipo = [
  {
    nombre: "Gonzalo Urrejola De la Barrera",
    cargo: "gerente comercial",
    email: "gonzalo.urrejola@biogreenrecicla.cl",
    telefono: "+56 9 8230 3729",
    profesion: "Ingeniero Civil Industrial e Ingeniero Ambiental",
    instagram: "biogreen_cl",
  },
  {
    nombre: "Joaquín Vargas Alarcón",
    cargo: "Gerente de Operaciones",
    email: "joaquin.vargas@biogreenrecicla.cl",
    telefono: "+56 9 7513 2551",
    profesion: "Ingeniero Comercial",
    instagram: "biogreen_cl",
  },
  {
    nombre: "Miguel Angel Silva Stuardo",
    cargo: "Gerente De Contratos",
    email: "miguel.silva@biogreenrecicla.cl",
    telefono: "+56 9 4205 9833",
    instagram: "biogreen_cl",
  },
  {
    nombre: "Germán bugmann Cartes",
    cargo: "Operaciones",
    email: "Contacto@biogreenrecicla.cl",
    telefono: "+56 9 8267 6802",
    instagram: "biogreen_cl",
  },
];
---

<section id="equipo" class="py-24 bg-gray-50 relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute right-0 bottom-0 w-96 h-96 bg-emerald-100 rounded-full mix-blend-multiply filter blur-3xl opacity-40 translate-x-1/3 translate-y-1/3"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Encabezado -->
    <div class="text-center mb-16">
      <h2 class="text-sm font-bold tracking-widest text-emerald-600 uppercase mb-3">Las personas detrás de BIOGREEN</h2>
      <h3 class="text-4xl md:text-5xl font-black text-gray-900 tracking-tight mb-5">Equipo de Trabajo</h3>
      <div class="w-24 h-1.5 bg-emerald-500 mx-auto rounded-full"></div>
    </div>

    <!-- Tarjetas del equipo -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 max-w-4xl mx-auto">
      {equipo.map(persona => (
        <div class="bg-white rounded-[2rem] shadow-xl border border-gray-100 overflow-hidden group hover:-translate-y-2 transition-all duration-500">

          <!-- Cabecera de color -->
          <div class="bg-gradient-to-br from-emerald-700 to-emerald-900 p-8 relative overflow-hidden">
            <div class="absolute -bottom-6 -right-6 w-28 h-28 bg-emerald-600 rounded-full opacity-30 blur-xl"></div>
            <!-- Avatar inicial -->
            <div class="w-20 h-20 bg-white/20 backdrop-blur-sm rounded-2xl flex items-center justify-center mb-5 ring-2 ring-white/30 shadow-lg">
              <span class="text-3xl font-black text-white">{persona.nombre.charAt(0)}</span>
            </div>
            <h4 class="text-white text-xl font-bold leading-tight mb-1">{persona.nombre}</h4>
            <span class="inline-block bg-emerald-500/40 text-emerald-100 text-sm font-semibold px-3 py-1 rounded-full border border-emerald-400/30 tracking-wide uppercase">
              {persona.cargo}
            </span>
          </div>

          <!-- Contenido -->
          <div class="p-8 space-y-5">

            <!-- Profesión -->
            <div class="flex items-start gap-4 group/item">
              <div class="w-10 h-10 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover/item:bg-emerald-600 group-hover/item:text-white transition-colors duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-0.5">Formación</p>
                <p class="text-gray-800 font-medium text-sm leading-snug">{persona.profesion}</p>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-center gap-4 group/item">
              <div class="w-10 h-10 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover/item:bg-emerald-600 group-hover/item:text-white transition-colors duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-0.5">Correo</p>
                <a href={`mailto:${persona.email}`} class="text-emerald-700 hover:text-emerald-500 font-medium text-sm transition-colors break-all">{persona.email}</a>
              </div>
            </div>

            <!-- Teléfono -->
            <div class="flex items-center gap-4 group/item">
              <div class="w-10 h-10 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover/item:bg-emerald-600 group-hover/item:text-white transition-colors duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-0.5">Teléfono</p>
                <a href={`tel:${persona.telefono.replace(/\s/g, '')}`} class="text-gray-800 hover:text-emerald-600 font-medium text-sm transition-colors">{persona.telefono}</a>
              </div>
            </div>

            <!-- Instagram -->
            <div class="flex items-center gap-4 group/item">
              <div class="w-10 h-10 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover/item:bg-emerald-600 group-hover/item:text-white transition-colors duration-300">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-0.5">Instagram</p>
                <a href={`https://instagram.com/${persona.instagram}`} target="_blank" rel="noopener noreferrer" class="text-emerald-700 hover:text-emerald-500 font-medium text-sm transition-colors">@{persona.instagram}</a>
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>
