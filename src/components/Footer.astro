---
// src/components/Footer.astro
import { Image } from "astro:assets";
import logoOscuro from "../assets/images/logo-oscuro.png";
const currentYear = new Date().getFullYear();
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

const quickLinks = [
  { name: "Inicio", href: `${base}` },
  { name: "Sobre Nosotros", href: `${base}nosotros` },
  { name: "Nuestros Servicios", href: `${base}servicios` },
  { name: "Impacto", href: `${base}impacto` },
  { name: "Contacto", href: `${base}contacto` },
];
---

<footer
  class="bg-verde-oscuro text-gris-claro text-gray-300 mt-auto border-t-4 border-verde-oscuro/20 relative overflow-hidden"
>
  <!-- Decorative Background elements -->
  <div
    class="absolute top-0 right-0 -translate-y-12 translate-x-1/3 w-96 h-96 bg-verde-oscuro text-gris-claro rounded-full mix-blend-multiply filter blur-3xl opacity-20 pointer-events-none"
  >
  </div>

  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20 relative z-10"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
      <div class="lg:col-span-2">
        <a href={import.meta.env.BASE_URL} class="flex items-center relative">
          <Image
            src={logoOscuro}
            alt="BIOGREEN Logo"
            class="h-32 w-auto object-contain transition-opacity duration-500"
            loading="lazy"
          />
        </a>
        <p
          class="text-gris-claro/60 max-w-md mb-8 leading-relaxed font-sans text-lg"
        >
          Transformando residuos orgánicos en oportunidades. Regeneramos el
          suelo, reducimos el impacto ambiental y contribuimos al ciclo de la
          vida mediante una gestión eficiente y compromiso ecológico.
        </p>

        <!-- Redes Sociales -->
        <div class="flex space-x-5">
          <a
            href="https://www.instagram.com/biogreen_cl"
            class="text-gris-claro/50 hover:text-verde hover:-translate-y-1 transition-all duration-300 transform"
            aria-label="Seguir en Instagram de BIOGREEN"
            target="_blank"
          >
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
              ></path>
            </svg>
          </a>
          <a
            href="#"
            class="text-gris-claro/50 hover:text-verde hover:-translate-y-1 transition-all duration-300 transform"
            aria-label="Visitar perfil de LinkedIn de BIOGREEN"
          >
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
              ></path>
            </svg>
          </a>
          <a
            href="#"
            class="text-gris-claro/50 hover:text-verde hover:-translate-y-1 transition-all duration-300 transform"
            aria-label="Visitar página de Facebook de BIOGREEN"
          >
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3
          class="text-sm titulo-secundario text-gris-claro tracking-wider uppercase mb-6 relative inline-block"
        >
          Enlaces Rápidos
          <span class="absolute -bottom-2 left-0 w-8 h-1 bg-verde rounded-full"
          ></span>
        </h3>
        <ul class="space-y-4">
          {
            quickLinks.map((link) => {
              const isActive =
                pathname === link.href || pathname === link.href + "/";
              return (
                <li>
                  <a
                    href={link.href}
                    class={`transition-colors flex items-center group ${isActive ? "text-verde" : "text-gris-claro/50 hover:text-verde"}`}
                  >
                    <span
                      class={`w-1.5 h-1.5 rounded-full bg-verde mr-3 transition-opacity ${isActive ? "opacity-100" : "opacity-0 group-hover:opacity-100"}`}
                    />
                    <span
                      class={`transform transition-transform ${isActive ? "" : "group-hover:translate-x-1"}`}
                    >
                      {link.name}
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3
          class="text-sm titulo-secundario text-gris-claro tracking-wider uppercase mb-6 relative inline-block"
        >
          Contáctanos
          <span class="absolute -bottom-2 left-0 w-8 h-1 bg-verde rounded-full"
          ></span>
        </h3>
        <ul class="space-y-5 text-gray-400">
          <li class="flex items-start">
            <svg
              class="h-6 w-6 text-verde mr-4 flex-shrink-0 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span class="leading-relaxed"
              >Santa Rosa de Quinel,<br /> Cabrero, Región del Bío Bío</span
            >
          </li>
          <li class="flex items-center">
            <svg
              class="h-6 w-6 text-verde mr-4 flex-shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <a
              href="mailto:contacto@biogreenrecicla.cl"
              class="hover:text-verde transition-colors font-medium"
              >contacto@biogreenrecicla.cl</a
            >
          </li>
          <li class="flex items-center">
            <svg
              class="h-6 w-6 text-verde mr-4 flex-shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            <a
              href="tel:+56975132551"
              class="hover:text-verde transition-colors font-medium"
              >+56 9 7513 2551</a
            >
          </li>
        </ul>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div
      class="mt-16 pt-8 border-t border-verde-oscuro/20 flex flex-col md:flex-row justify-between items-center text-gris-claro/50 text-sm"
    >
      <p>&copy; {currentYear} BIOGREEN. Todos los derechos reservados.</p>
      <div class="mt-4 md:mt-0 space-x-6">
        <a href="#" class="hover:text-verde transition-colors relative group">
          Términos de servicio
          <span
            class="absolute -bottom-1 left-0 w-0 h-[1px] bg-verde transition-all duration-300 group-hover:w-full"
          ></span>
        </a>
        <a href="#" class="hover:text-verde transition-colors relative group">
          Política de privacidad
          <span
            class="absolute -bottom-1 left-0 w-0 h-[1px] bg-verde transition-all duration-300 group-hover:w-full"
          ></span>
        </a>
      </div>
    </div>
  </div>
</footer>
