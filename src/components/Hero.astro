---
// src/components/Hero.astro
import { Image } from "astro:assets";
import heroBg from "../assets/images/hero-bg-2.jpg";
---

<section
  id="inicio"
  class="relative min-h-[600px] h-[80vh] md:min-h-screen flex items-center justify-center bg-verde-oscuro text-gris-claro pt-20 overflow-hidden"
>
  <!-- Imagen de fondo optimizada para responsivo -->
  <div class="absolute inset-0 z-0">
    <Image
      src={heroBg}
      alt="Fondo de campo verde BioGreen"
      class="w-full h-full object-cover object-center"
      loading="eager"
    />
    <!-- Overlay original para legibilidad -->
    <div class="absolute inset-0 bg-verde-oscuro/25"></div>
  </div>

  <div class="relative z-10 text-center px-4 max-w-5xl mx-auto">
    <h1
      class="text-3xl sm:text-4xl md:text-6xl font-title mb-4 tracking-tight text-gris-claro leading-tight"
    >
      Valorización de residuos orgánicos industriales
    </h1>
    <h2 class="text-base sm:text-base md:text-xl font-title mb-6">
      Transformamos residuos en compost mediante procesos controlados
    </h2>
    <a
      href={`${import.meta.env.BASE_URL}contacto`}
      class="group relative inline-flex items-center justify-center px-8 py-3.5 text-base titulo-secundario text-gris-claro transition-all duration-200 bg-verde border border-transparent rounded-full hover:bg-verde-oscuro text-gris-claro hover:shadow-lg hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:border-verde-oscuro/20"
    >
      Contáctanos
      <svg
        class="w-5 h-5 ml-2 -mr-1 transition-transform duration-200 group-hover:translate-x-1"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </a>
  </div>

  <a
    href="#bienvenidos"
    class="absolute bottom-10 left-1/2 transform -translate-x-1/2 animate-bounce flex flex-col items-center group hover:scale-105 transition-transform cursor-pointer z-20"
    onclick="event.preventDefault(); document.getElementById('bienvenidos').scrollIntoView({behavior: 'smooth'});"
  >
    <span
      class="text-gris-claro group-hover:text-gris-claro transition-colors text-sm mb-2 titulo-secundario"
      >Descubre más</span
    >
    <svg
      class="w-6 h-6 text-gris-claro group-hover:text-gris-claro transition-colors"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg
    >
  </a>
</section>
