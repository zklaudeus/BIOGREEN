---
// src/components/Hero.astro
---

<section
  id="inicio"
  class="relative min-h-screen flex items-center justify-center bg-emerald-900 text-white pt-20"
>
  <div class="absolute inset-0 z-0">
    <div
      class="w-full h-full bg-gradient-to-br from-emerald-800 to-green-900 opacity-90"
    >
    </div>
  </div>

  <div class="relative z-10 text-center px-4 max-w-5xl mx-auto">
    <h1 class="text-4xl md:text-6xl font-black mb-6 tracking-tight text-white">
      Valorización de residuos orgánicos industriales
    </h1>
    <h2 class="text-2xl md:text-4xl font-semibold mb-6 text-emerald-100">
      Transformamos residuos en compost mediante procesos controlados
    </h2>
    <p
      class="text-xl md:text-2xl mb-12 text-emerald-50 font-light italic max-w-3xl mx-auto"
    >
    </p>
    <a
      href="/contacto"
      class="inline-block bg-white text-emerald-900 hover:bg-emerald-50 font-bold py-4 px-10 rounded-full transition-all duration-300 shadow-xl hover:shadow-2xl transform hover:-translate-y-1 text-lg"
    >
      Contáctanos
    </a>
  </div>

  <a
    href="#bienvenidos"
    class="absolute bottom-10 left-1/2 transform -translate-x-1/2 animate-bounce flex flex-col items-center group hover:scale-105 transition-transform cursor-pointer z-20"
    onclick="event.preventDefault(); document.getElementById('bienvenidos').scrollIntoView({behavior: 'smooth'});"
  >
    <span
      class="text-emerald-100 group-hover:text-white transition-colors text-sm mb-2 font-medium"
      >Descubre más</span
    >
    <svg
      class="w-6 h-6 text-emerald-100 group-hover:text-white transition-colors"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg
    >
  </a>
</section>
