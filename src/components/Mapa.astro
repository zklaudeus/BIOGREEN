---
// src/components/Mapa.astro
---

<section id="ubicacion" class="py-24 bg-gris-claro relative overflow-hidden">
  <!-- Elementos decorativos de fondo -->
  <div
    class="absolute top-0 right-0 w-1/3 h-full bg-gris-claro opacity-40 transform -skew-x-12 hidden lg:block"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-gris-claro text-verde-oscuro text-sm font-bold tracking-wide mb-4"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
            clip-rule="evenodd"></path>
        </svg>
        Nuestra Ubicación
      </div>
      <h2
        class="text-4xl lg:text-5xl font-black text-verde-oscuro mb-6 tracking-tight"
      >
        Visita Nuestra Planta
      </h2>
      <p
        class="text-lg text-verde-oscuro max-w-2xl mx-auto font-light leading-relaxed"
      >
        Ubicados estratégicamente en la Región del Bío Bío para ofrecer un
        servicio eficiente y de calidad a nuestros clientes de toda la zona
        centro-sur.
      </p>
    </div>

    <div
      class="bg-gris-claro rounded-[2rem] shadow-2xl overflow-hidden flex flex-col lg:flex-row border border-verde-oscuro/20 transform transition-all hover:shadow-verde-oscuro/10/50"
    >
      <!-- Panel de Detalles -->
      <div
        class="w-full lg:w-1/3 bg-verde-oscuro text-gris-claro text-gris-claro p-10 lg:p-14 flex flex-col justify-center relative overflow-hidden"
      >
        <!-- Textura/Gradiente fondo panel -->
        <div
          class="absolute inset-0 bg-gradient-to-br from-verde-oscuro to-verde opacity-90"
        >
        </div>
        <div
          class="absolute top-0 right-0 w-64 h-64 bg-verde rounded-full mix-blend-screen filter blur-[80px] opacity-30 -translate-y-1/2 translate-x-1/2 pointer-events-none"
        >
        </div>

        <div class="relative z-10">
          <h3 class="text-3xl font-bold mb-8 text-gris-claro">BIOGREEN SPA</h3>

          <ul class="space-y-8">
            <li class="flex items-start group">
              <div
                class="bg-verde-oscuro text-gris-claro/50 p-3 rounded-xl mr-5 group-hover:bg-verde transition-colors duration-300"
              >
                <svg
                  class="h-6 w-6 text-verde group-hover:text-gris-claro transition-colors"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <p
                  class="text-verde font-semibold mb-1 text-sm tracking-wide uppercase"
                >
                  Dirección
                </p>
                <p class="text-lg text-gray-200 leading-snug">
                  Santa Rosa de Quinel<br />Cabrero, Región del Bío Bío
                </p>
              </div>
            </li>

            <li class="flex items-start group">
              <div
                class="bg-verde-oscuro text-gris-claro/50 p-3 rounded-xl mr-5 group-hover:bg-verde transition-colors duration-300"
              >
                <svg
                  class="h-6 w-6 text-verde group-hover:text-gris-claro transition-colors"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
              <div>
                <p
                  class="text-verde font-semibold mb-1 text-sm tracking-wide uppercase"
                >
                  Correo Electrónico
                </p>
                <a
                  href="mailto:contacto@biogreenrecicla.cl"
                  class="text-lg text-gray-200 hover:text-gris-claro transition-colors"
                  >contacto@biogreenrecicla.cl</a
                >
              </div>
            </li>
          </ul>

          <div class="mt-12 pt-8 border-t border-verde-oscuro/20">
            <a
              href="https://www.google.com/maps/place/36%C2%B056'48.3%22S+72%C2%B028'05.6%22W/@-36.94684,-72.4909244,14z/data=!4m4!3m3!8m2!3d-36.94675!4d-72.4682222?entry=ttu&g_ep=EgoyMDI2MDQxMi4wIKXMDSoASAFQAw%3D%3D"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center text-verde hover:text-emerald-300 transition-colors font-semibold"
            >
              <span
                class="border-b border-transparent group-hover:border-verde-oscuro/20 transition-colors pb-0.5"
                >Abrir indicaciones en Google Maps</span
              >
              <svg
                class="w-5 h-5 ml-2 transform transition-transform group-hover:translate-x-1"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Contenedor del Mapa (Iframe interactiv) -->
      <div
        class="w-full lg:w-2/3 h-[450px] lg:h-auto min-h-[500px] bg-gris-claro relative"
      >
        <!-- Mapa centrado en Cabrero/Quinel -->
        <iframe
          title="Ubicación de la Planta BIOGREEN"
          src="https://www.google.com/maps?q=-36.9467500,-72.4682222&output=embed"
          class="absolute inset-0 w-full h-full border-0 grayscale-[20%] contrast-[1.05]"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        >
        </iframe>
      </div>
    </div>
  </div>
</section>
