---
// src/components/Navbar.astro
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const cleanPath = pathname.replace(/\/$/, '') || '/';
const cleanBase = base.replace(/\/$/, '') || '/';
const isHome = cleanPath === cleanBase || cleanPath === `${cleanBase}/index.html`;

const links = [
  { name: 'Inicio', href: base },
  { name: 'Nosotros', href: `${base}nosotros` },
  { name: 'Servicios', href: `${base}servicios` },
  { name: 'Impacto', href: `${base}impacto` },
  { name: 'Contacto', href: `${base}contacto` },
];
---

<header id="navbar" data-ishome={isHome.toString()} class={`fixed w-full  top-0 z-50 transition-all duration-300  ${isHome ? 'text-gris-claro' : 'text-verde-oscuro'}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center relative z-50">
      
      <!-- Logo alineado a la izquierda con doble imagen para transición suave -->
      <a href={import.meta.env.BASE_URL} class="flex items-center relative">
        <img id="logo-light" src={`${import.meta.env.BASE_URL}images/logofondoclaro.png`} alt="BIOGREEN Claro" class="logo-img h-20 w-auto object-contain" />
        <img id="logo-dark" src={`${import.meta.env.BASE_URL}images/logofondooscuro.png`} alt="BIOGREEN Oscuro" class="logo-img absolute top-0 left-0 h-full w-full object-contain opacity-0 pointer-events-none" />
      </a>

      <!-- Menú a la derecha (Desktop) -->
      <nav class="hidden md:flex space-x-8">
        {links.map(link => {
          const isActive = pathname === link.href || pathname === link.href + '/';
          return (
          <a 
            href={link.href} 
            class={`nav-link relative text-sm font-medium transition-colors duration-300 ${isActive ? 'text-verde font-bold' : ''}`}
            aria-current={isActive ? 'page' : undefined}
          >
            {link.name}
            <!-- Hover Underline Animado -->
            <span class={`nav-indicator absolute left-0 -bottom-1 h-[2px] transition-all duration-300 ${isActive ? 'w-full bg-verde' : 'w-0'}`}></span>
          </a>
          );
        })}
      </nav>

      <!-- Botón Menú Hamburguesa (Mobile) -->
      <button 
        id="menu-toggle" 
        class="md:hidden flex flex-col items-center justify-center w-8 h-8 gap-[5px] focus:outline-none"
        aria-label="Toggle Menu"
      >
        <span class="line-1 w-6 h-[2px] bg-current transition-transform duration-300 ease-in-out"></span>
        <span class="line-2 w-6 h-[2px] bg-current transition-opacity duration-300 ease-in-out"></span>
        <span class="line-3 w-6 h-[2px] bg-current transition-transform duration-300 ease-in-out"></span>
      </button>

    </div>
  </div>

  <!-- Menú Desplegable (Mobile) -->
  <div 
    id="mobile-menu" 
    class="absolute top-0 left-0 w-full bg-gris-claro text-verde-oscuro shadow-xl overflow-hidden transition-all duration-500 ease-in-out z-40 max-h-0 opacity-0"
  >
    <div class="pt-24 pb-8 px-6 flex flex-col space-y-4 text-center text-lg font-medium">
      {links.map(link => {
        const isActive = pathname === link.href || pathname === link.href + '/';
        return (
        <a 
          href={link.href} 
          class={`mobile-nav-link transition-colors duration-300 ${isActive ? 'text-verde font-bold' : 'text-verde-oscuro'}`}
          aria-current={isActive ? 'page' : undefined}
        >
          {link.name}
        </a>
        );
      })}
    </div>
  </div>
</header>

<style>
  /* ====== Estado Inicial (Top) ====== */
  #navbar {
    background-color: transparent;
    --hover-color: var(--color-verde);
    --indicator-color: var(--color-verde);
  }
  
  /* ====== Lógica de Intercambio de Logos ====== */
  /* Estado por defecto (Ej: Páginas internas o Navbar Scrolled) -> Mostrar Claro, Ocultar Oscuro */
  #logo-light { opacity: 1; }
  #logo-dark { opacity: 0; pointer-events: none; }

  /* Solo en página inicial y Navbar TOP -> Mostrar Oscuro, Ocultar Claro */
  #navbar[data-ishome="true"]:not(.is-scrolled) #logo-light {
    opacity: 0;
  }
  #navbar[data-ishome="true"]:not(.is-scrolled) #logo-dark {
    opacity: 1;
    pointer-events: auto;
  }

  /* ====== Logo: transición suave de tamaño ====== */
  .logo-img {
    height: 5rem; /* 80px por defecto */
    transition: height 0.4s ease, opacity 0.5s ease;
  }

  /* ====== Estado con Scroll ====== */
  #navbar.is-scrolled {
    background-color: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(16px);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    color: var(--color-verde-oscuro) !important;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    --hover-color: var(--color-verde);
    --indicator-color: var(--color-verde);
  }

  /* Logo más pequeño al hacer scroll */
  #navbar.is-scrolled .logo-img {
    height: 3rem; /* 48px — compacto */
  }
  
  /* ====== Estado Menú Móvil Abierto ====== */
  #navbar.menu-open {
    color: #1f2937; /* Forzar logo e icono oscuro para que contraste en bg-gris-claro */
    --hover-color: #10b981;
  }
  
  #navbar.menu-open #mobile-menu {
    max-height: 400px; /* Suficiente para los links */
    opacity: 1;
  }

  /* ====== Animaciones de Hover Links ====== */
  .nav-link:hover {
    color: var(--hover-color);
  }
  
  .nav-link .nav-indicator {
    background-color: var(--indicator-color);
  }
  
  .nav-link:hover .nav-indicator {
    width: 100%;
  }

  .mobile-nav-link:hover {
    color: #10b981;
  }

  /* ====== Animaciones Botón Hamburguesa ====== */
  #navbar.menu-open .line-1 {
    transform: translateY(7px) rotate(45deg);
  }
  #navbar.menu-open .line-2 {
    opacity: 0;
  }
  #navbar.menu-open .line-3 {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>

<script>
  // El script de Astro maneja las interacciones del cliente
  document.addEventListener("DOMContentLoaded", () => {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    const menuToggle = document.getElementById('menu-toggle');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');
    
    let isMenuOpen = false;

    // Manejar el efecto scroll
    const handleScroll = () => {
      if (window.scrollY > 20) {
        navbar.classList.add('is-scrolled');
      } else {
        navbar.classList.remove('is-scrolled');
      }
    };

    // Manejar toggle menú móvil
    const toggleMenu = () => {
      isMenuOpen = !isMenuOpen;
      if (isMenuOpen) {
        navbar.classList.add('menu-open');
        document.body.style.overflow = 'hidden'; // Bloquea scroll en la página al abrir menú
      } else {
        navbar.classList.remove('menu-open');
        document.body.style.overflow = ''; // Restaura scroll
      }
    };

    // Listeners
    window.addEventListener('scroll', handleScroll, { passive: true });
    
    if (menuToggle) {
      menuToggle.addEventListener('click', toggleMenu);
    }

    // Cerrar menú móvil al hacer click en cualquier link
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (isMenuOpen) toggleMenu();
      });
    });

    // Validar en la carga inicial
    handleScroll();
  });
</script>
