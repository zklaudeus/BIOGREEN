---
// src/components/NuestrosResultados.astro
import sacoImage from "../assets/saco.png";
---

<section
  id="nuestros-resultados"
  class="py-24 bg-white relative overflow-hidden"
>
  <!-- Fondo decorativo suave -->
  <div
    class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-emerald-50 to-transparent opacity-60 pointer-events-none"
  >
  </div>
  <div
    class="absolute -bottom-32 -left-32 w-96 h-96 bg-green-100 rounded-full mix-blend-multiply filter blur-3xl opacity-30 pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-20">
      <!-- Columna de Texto -->
      <div class="w-full lg:w-1/2">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-100 text-emerald-800 text-sm font-bold tracking-wide mb-6"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"
            ></path>
          </svg>
          Producto Final
        </div>

        <h2
          class="text-4xl md:text-5xl font-black text-gray-900 tracking-tight leading-tight mb-8"
        >
          Nuestro<br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-green-500"
            >Resultado</span
          >
        </h2>

        <!-- Tarjeta de contenido principal resaltada -->
        <div
          class="relative bg-white rounded-3xl p-8 md:p-10 shadow-xl border border-emerald-100 mb-8 z-10"
        >
          <div
            class="absolute -top-4 -left-4 w-8 h-8 bg-emerald-500 rounded-full flex items-center justify-center text-white shadow-lg"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="3"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <p
            class="text-lg md:text-xl text-gray-700 leading-relaxed font-light relative z-10"
          >
            El compost <strong class="font-bold text-emerald-700"
              >BIOGREEN</strong
            > es un abono natural, estabilizado y ensacado, listo para su uso o comercialización.
            Representa el cierre de un ciclo sustentable: <span
              class="text-emerald-600 font-medium"
              >transformar residuos en valor para el suelo.</span
            >
          </p>
        </div>

        <div class="flex items-center gap-3 text-sm font-medium text-gray-500">
          <svg
            class="w-5 h-5 text-emerald-500"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Garantía de calidad y estabilización en cada saco.
        </div>
      </div>

      <!-- Columna de Imagen (Saco de Compost) -->
      <div class="w-full lg:w-1/2 flex justify-center relative">
        <!-- Elementos decorativos de fondo para la imagen -->
        <div
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-72 h-72 md:w-96 md:h-96 bg-emerald-200 rounded-full mix-blend-multiply filter blur-2xl opacity-50 animate-pulse"
        >
        </div>
        <div
          class="absolute -inset-4 border-2 border-dashed border-emerald-200 rounded-3xl transform rotate-3 -z-10 hidden md:block"
        >
        </div>

        <!-- Contenedor de la Imagen -->
        <div
          class="relative w-full max-w-sm aspect-[4/5] rounded-3xl bg-gray-50 border-4 border-white shadow-2xl overflow-hidden group flex items-center justify-center p-6"
        >
          <!-- Imagen del Saco -->
          <img
            src={sacoImage.src}
            alt="Saco de Compost BIOGREEN"
            class="w-full h-full object-contain transition-transform duration-700 group-hover:scale-105 drop-shadow-xl z-20"
          />

          <!-- Etiqueta flotante inferior -->
          <div
            class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-black/60 to-transparent flex justify-center z-30 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
          >
            <span
              class="bg-white/90 backdrop-blur text-emerald-800 text-xs font-bold uppercase tracking-widest px-4 py-2 rounded-full shadow-lg"
            >
              Saco de Compost 50L
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
