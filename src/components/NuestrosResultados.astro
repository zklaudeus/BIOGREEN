---
// src/components/NuestrosResultados.astro
import { Image } from "astro:assets";
import sacoCompost from "../assets/images/vertical-3.jpg";
---

<section
  id="nuestros-resultados"
  class="py-24 relative overflow-hidden"
>
  <!-- Fondo decorativo suave -->
  <div
    class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-verde-oscuro to-transparent opacity-60 pointer-events-none"
  >
  </div>
  <div
    class="absolute -bottom-32 -left-32 w-96 h-96 bg-green-100 rounded-full mix-blend-multiply filter blur-3xl opacity-30 pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-20">
      <!-- Columna de Texto -->
      <div class="w-full lg:w-1/2">
        <div
          class="inline-flex items-center font-semibold gap-2 px-4 py-2 rounded-full border border-verde-oscuro/10 text-verde-oscuro text-sm titulo-secundario tracking-wide mb-6"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"
            ></path>
          </svg>
          Producto Final
        </div>

        <h2
          class="text-4xl font-semibold md:text-5xl font-title text-verde-oscuro tracking-tight leading-tight mb-8"
        >
          Nuestro<br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-[#002424] to-[#0bb580]"
            >Resultado</span
          >
        </h2>

        <!-- Tarjeta de contenido principal resaltada -->
        <div
          class="relative rounded-3xl p-8 md:p-10 shadow-xl border border-verde-oscuro/20 mb-8 z-10"
        >
          <div
            class="absolute -top-4 -left-4 w-8 h-8 bg-verde rounded-full flex items-center justify-center text-gris-claro shadow-lg"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="3"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <p
            class="text-lg md:text-xl text-verde-oscuro leading-relaxed relative z-10 font-sans"
          >
            El compost <strong class="titulo-secundario text-verde-oscuro"
              >BIOGREEN</strong
            > es un abono natural, estabilizado y ensacado, listo para su uso o comercialización.
            Representa el cierre de un ciclo sustentable:
            <span class="block mt-4 text-verde titulo-secundario text-base"
              >transformar residuos en valor para el suelo.</span
            >
          </p>
        </div>

        <div
          class="flex items-center gap-3 text-sm titulo-secundario text-verde-oscuro/60"
        >
          <svg
            class="w-5 h-5 text-verde"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Garantía de calidad y estabilización en cada saco.
        </div>
      </div>

      <!-- Columna de Imagen (Saco de Compost) -->
      <div class="w-full lg:w-1/2 flex justify-center relative">
        <!-- Elementos decorativos de fondo para la imagen -->
        <div
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-72 h-72 md:w-96 md:h-96 bg-verde/20 rounded-full mix-blend-multiply filter blur-2xl opacity-50 animate-pulse"
        >
        </div>
        <div
          class="absolute -inset-4 border-2 border-dashed border-verde-oscuro/20 rounded-3xl transform rotate-3 -z-10 hidden md:block"
        >
        </div>

        <!-- Contenedor de la Imagen -->
        <div
          class="relative w-full h-full max-w-sm aspect-[5/5] rounded-3xl shadow-2xl overflow-hidden group"
        >
          <!-- Imagen del Saco -->
          <Image
            src={sacoCompost}
            alt="Saco de Compost BIOGREEN"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 z-20"
          />

          <!-- Etiqueta flotante inferior -->
          <div
            class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-black/60 to-transparent flex justify-center z-30 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
          >
            <span
              class="bg-white/90 backdrop-blur text-verde-oscuro text-xs titulo-secundario uppercase tracking-widest px-4 py-2 rounded-full shadow-lg"
            >
              Compost</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
