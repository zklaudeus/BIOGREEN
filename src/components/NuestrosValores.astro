---
// src/components/NuestrosValores.astro
const valores = [
  {
    nombre: "Sostenibilidad",
    descripcion: "Priorizamos prácticas que respetan y restauran el entorno natural.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
  },
  {
    nombre: "Transparencia",
    descripcion: "Entregamos trazabilidad y respaldo a nuestros clientes.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
  },
  {
    nombre: "Innovación",
    descripcion: "Buscamos constantemente mejorar nuestros procesos y soluciones.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>`,
  },
  {
    nombre: "Calidad",
    descripcion: "Producimos compost con valor real para el suelo y la agricultura.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>`,
  },
  {
    nombre: "Compromiso",
    descripcion: "Cumplimos con altos estándares operativos y ambientales.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>`,
  },
  {
    nombre: "Impacto Social",
    descripcion: "Aportamos al desarrollo local y la educación ambiental.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
  },
];
---

<section id="valores" class="py-24 bg-gris-claro relative overflow-hidden">
  <!-- Decorativo -->
  <div class="absolute top-0 left-0 w-1/3 h-1 bg-gradient-to-r from-verde-oscuro to-transparent"></div>
  <div class="absolute bottom-0 right-0 w-1/3 h-1 bg-gradient-to-l from-verde-oscuro to-transparent"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Encabezado -->
    <div class="text-center mb-16">
      <h2 class="subtitulo text-sm titulo-secundario text-verde mb-3">Lo que nos define</h2>
      <h3 class="text-4xl md:text-5xl font-title text-verde-oscuro tracking-tight mb-5">Nuestros Valores</h3>
      <div class="w-24 h-1.5 bg-verde mx-auto rounded-full"></div>
    </div>

    <!-- Grid de 3 columnas con 6 valores -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {valores.map((valor, i) => (
        <div class="group relative flex flex-col items-start p-8 rounded-3xl border border-verde-oscuro/20 bg-gris-claro shadow-md hover:shadow-xl hover:-translate-y-2 transition-all duration-300 overflow-hidden">
          <!-- Decorative corner blob -->
          <div class="absolute top-0 right-0 w-20 h-20 bg-gris-claro rounded-bl-full opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

          <!-- Número de orden -->
          <span class="absolute top-6 right-7 text-4xl font-sans text-verde-oscuro/10 group-hover:text-verde-oscuro/20 transition-colors select-none leading-none">
            {String(i + 1).padStart(2, '0')}
          </span>

          <!-- Ícono -->
          <div class="w-16 h-16 bg-gris-claro text-verde rounded-2xl flex items-center justify-center mb-6 group-hover:bg-verde group-hover:text-gris-claro transition-all duration-300 shadow-sm">
            <Fragment set:html={valor.icon} />
          </div>

          <!-- Contenido -->
          <h4 class="text-xl titulo-secundario text-verde-oscuro mb-3 tracking-tight uppercase">{valor.nombre}</h4>
          <p class="text-verde-oscuro/60 leading-relaxed font-sans">{valor.descripcion}</p>

          <!-- Línea decorativa inferior -->
          <div class="w-0 h-0.5 bg-verde mt-6 rounded-full transition-all duration-500 group-hover:w-12"></div>
        </div>
      ))}
    </div>
  </div>
</section>
