---
// src/components/quehacemos.astro
---

<section id="que-hacemos" class="py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 pt-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-sm titulo-secundario text-verde mb-3 font-semibold">
        Nuestra Labor
      </h2>
      <h1
        class="text-4xl md:text-5xl font-title text-verde-oscuro mb-6 tracking-tight font-semibold"
      >
        ¿Qué hacemos?
      </h1>
      <div class="w-24 h-1.5 bg-verde mx-auto rounded-full"></div>
    </div>

    <!-- Grid de 5 puntos (3 arriba, 2 abajo centrados) usando un sistema de 6 columnas -->
    <div class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-6 gap-8">
      <!-- Punto 1 -->
      <div
        class="md:col-span-2 lg:col-span-2 rounded-3xl p-8 shadow-lg border border-verde-oscuro/20 hover:shadow-xl transition-shadow duration-300 group"
      >
        <div
          class="w-14 h-14 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-verde transition-all duration-300"
        >
          <svg
            class="w-8 h-8 text-verde group-hover:text-gris-claro transition-colors"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
          </svg>
        </div>
        <h4 class="text-xl titulo-secundario text-verde-oscuro mb-3">
          Recepción Estratégica
        </h4>
        <p class="text-verde-oscuro leading-relaxed font-sans">
          Recepcionamos residuos orgánicos de empresas, industrias,
          agroprocesadoras y faenas forestales.
        </p>
      </div>

      <!-- Punto 2 -->
      <div
        class="md:col-span-2 lg:col-span-2 rounded-3xl p-8 shadow-lg border border-verde-oscuro/20 hover:shadow-xl transition-shadow duration-300 group"
      >
        <div
          class="w-14 h-14 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-verde transition-all duration-300"
        >
          <svg
            class="w-8 h-8 text-verde group-hover:text-gris-claro transition-colors"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
            ></path>
          </svg>
        </div>
        <h4 class="text-xl titulo-secundario text-verde-oscuro mb-3">
          Destino Autorizado
        </h4>
        <p class="text-verde-oscuro leading-relaxed font-sans">
          Actuamos como destino final autorizado, evitando vertederos y
          asegurando cumplimiento normativo.
        </p>
      </div>

      <!-- Punto 3 -->
      <div
        class="md:col-span-2 md:col-start-2 lg:col-span-2 lg:col-start-auto bg-gris-claro rounded-3xl p-8 shadow-lg border border-verde-oscuro/20 hover:shadow-xl transition-shadow duration-300 group"
      >
        <div
          class="w-14 h-14 bg-gris-claro rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-verde transition-all duration-300"
        >
          <svg
            class="w-8 h-8 text-verde group-hover:text-gris-claro transition-colors"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
            ></path>
          </svg>
        </div>
        <h4 class="text-xl titulo-secundario text-verde-oscuro mb-3">
          Proceso Industrial
        </h4>
        <p class="text-verde-oscuro leading-relaxed font-sans">
          Aplicamos un proceso de compostaje industrial controlado, con altos
          estándares sanitarios y ambientales.
        </p>
      </div>

      <!-- Punto 4 -->
      <div
        class="md:col-span-2 lg:col-span-2 lg:col-start-2 bg-gris-claro rounded-3xl p-8 shadow-lg border border-verde-oscuro/20 hover:shadow-xl transition-shadow duration-300 group"
      >
        <div
          class="w-14 h-14 bg-gris-claro rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-verde transition-all duration-300"
        >
          <svg
            class="w-8 h-8 text-verde group-hover:text-gris-claro transition-colors"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path>
          </svg>
        </div>
        <h4 class="text-xl titulo-secundario text-verde-oscuro mb-3">
          Trazabilidad Total
        </h4>
        <p class="text-verde-oscuro leading-relaxed font-sans">
          Generamos trazabilidad completa y respaldos documentales de toda la
          gestión realizada.
        </p>
      </div>

      <!-- Punto 5 -->
      <div
        class="md:col-span-2 md:col-start-2 lg:col-span-2 lg:col-start-4 bg-gris-claro rounded-3xl p-8 shadow-lg border border-verde-oscuro/20 hover:shadow-xl transition-shadow duration-300 group"
      >
        <div
          class="w-14 h-14 bg-gris-claro rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-verde transition-all duration-300"
        >
          <svg
            class="w-8 h-8 text-verde group-hover:text-gris-claro transition-colors"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
            ></path>
          </svg>
        </div>
        <h4 class="text-xl titulo-secundario text-verde-oscuro mb-3">
          Economía Circular
        </h4>
        <p class="text-verde-oscuro leading-relaxed font-sans">
          Transformamos desechos en compost, contribuyendo a la economía
          circular y regeneración del suelo.
        </p>
      </div>
    </div>
  </div>
</section>
