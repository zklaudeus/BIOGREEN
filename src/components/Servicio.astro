---
// src/components/Servicio.astro
const residuos = [
  {
    title: "Industria agroalimentaria",
    items: [
      "Residuos de la industria agroalimentaria",
      "Residuos de procesos alimentarios",
      "Subproductos orgánicos de origen vegetal o animal",
      "Residuos del procesamiento de carnes, frutas, verduras y lácteos",
    ],
  },
  {
    title: "Industria pesquera y cárnica",
    items: [
      "Lodos y residuos derivados de pescado",
      "Residuos del procesamiento de carnes y pescados",
    ],
  },
  {
    title: "Industria láctea",
    items: [
      "Residuos de la industria láctea",
      "Sueros, leches y grasas derivadas",
    ],
  },
  {
    title: "Industria vitivinícola y bebidas",
    items: [
      "Residuos de la industria vitivinícola",
      "Subproductos de fermentación",
    ],
  },
  {
    title: "Grasas y aceites",
    items: ["Residuos de tratamiento de grasas", "Ceras animales o vegetales"],
  },
  {
    title: "RILES (no peligrosos)",
    items: ["Lodos orgánicos provenientes de plantas de tratamiento"],
  },
  {
    title: "Residuos orgánicos comerciales",
    items: [
      "Casinos, restaurantes y supermercados",
      "Centros de distribución de alimentos",
    ],
  },
  {
    title: "Industria de la madera y derivados",
    items: [
      "Residuos de madera industrial no peligrosos",
      "Subproductos de procesos de fabricación de tableros",
      "Materiales derivados de la madera provenientes de procesos productivos",
    ],
  },
];
---

<section
  id="residuos-autorizados"
  class="py-24 bg-gris-claro relative overflow-hidden"
>
  <!-- Decorativo fondo -->
  <div
    class="absolute -right-20 top-1/4 w-80 h-80 bg-gris-claro rounded-full filter blur-3xl opacity-60 pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col lg:flex-row items-start gap-16 lg:gap-20">
      <!-- Columna izquierda: Texto explicativo -->
      <div class="w-full lg:w-5/12 lg:sticky lg:top-28">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-gris-claro text-verde-oscuro text-sm titulo-secundario tracking-wide mb-6"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          Planta Autorizada
        </div>

        <h2
          class="text-4xl md:text-5xl font-title text-verde-oscuro tracking-tight leading-tight mb-6"
        >
          Residuos<br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-verde-oscuro to-green-500"
            >Autorizados</span
          >
        </h2>

        <p class="text-lg text-verde-oscuro/60 leading-relaxed mb-8 font-sans">
          Contamos con autorización para recepcionar una amplia gama de residuos
          orgánicos no peligrosos compatibles con el proceso de compostaje
          industrial.
        </p>

        <!-- Nota legal -->
        <div
          class="bg-gris-claro border-l-4 border-verde-oscuro/20 rounded-r-2xl p-6"
        >
          <p class="text-sm text-verde-oscuro font-sans leading-relaxed">
            <span class="titulo-secundario">Importante:</span> Todos los residuos
            recepcionados deben ser orgánicos, no peligrosos y compatibles con el
            proceso de compostaje. El manejo se realiza conforme al <span
              class="font-title">Manual de Procedimientos autorizado.</span
            >
          </p>
        </div>
      </div>

      <!-- Columna derecha: Lista de residuos -->
      <div class="w-full lg:w-7/12 grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          residuos.map((categoria) => (
            <div class="group p-6 rounded-2xl border border-verde-oscuro/20 bg-gris-claro shadow-sm hover:shadow-lg hover:-translate-y-1 hover:border-verde-oscuro/20 transition-all duration-300">
              <h3 class="text-xl font-title text-verde-oscuro mb-4 group-hover:text-verde-oscuro transition-colors duration-300">
                {categoria.title}
              </h3>
              <ul class="space-y-3">
                {categoria.items.map((item) => (
                  <li class="flex items-start gap-3">
                    <svg
                      class="w-5 h-5 text-verde flex-shrink-0 mt-0.5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                    <span class="text-verde-oscuro leading-snug font-sans">
                      {item}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
